{
  "name": "reparzo-backend",
  "version": "1.0.0",
  "description": "Reparzo — Edge REST API Service",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply reparzo-db --local",
    "db:migrate:remote": "CI=true wrangler d1 migrations apply reparzo-db --remote",
    "db:populate": "tsx scripts/populate-catalog.ts",
    "db:populate:local": "tsx scripts/populate-catalog.ts --local",
    "db:populate:remote": "tsx scripts/populate-catalog.ts --remote"
  },
  "keywords": [
    "reparzo",
    "cloudflare-workers",
    "hono",
    "d1",
    "drizzle-orm"
  ],
  "author": "Charan",
  "license": "ISC",
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "jose": "^6.2.11"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260904.1",
    "@types/node": "^26.4.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "wrangler": "^4.137.0"
  }
}
